# vm-template profile for a Raspberry Pi 4 kiosk on Raspberry Pi OS (Debian 13 trixie,
# arm64). Source it, then run the modules; see docs/RASPBERRY-PI.md for what each line does
# and what this profile does not cover.
#
#   set -a; . examples/raspberry-pi-kiosk.env; set +a
#   sudo -E make harden
#   sudo -E make audit
#
# Nothing in this file has been run on a physical Raspberry Pi. Lines marked PLACEHOLDER
# must be changed before use.

# The account that gets sudo and the SSH key. PLACEHOLDER: use your own admin name.
export ADMIN_USER=admin

# Base tier: no auditd. journald is handled below.
export TIER=base

# The kiosk runs no containers, so the Docker module has nothing to do. The audit
# reports its controls as [skip].
export SKIP_MODULES=docker

# Keep the journal in RAM, capped at 32M, so logs do not wear the SD card. Logs are lost
# on reboot. Use persistent (the default) if the Pi boots from an SSD.
export JOURNAL_STORAGE=volatile

# Do not block first boot on a long dist-upgrade. unattended-upgrades applies updates
# later, from the Debian and Raspberry Pi archives.
export UPDATE_SKIP_DIST_UPGRADE=1

# Keep kernel, firmware and bootloader packages out of unattended upgrades so they are
# updated in a supervised step. PLACEHOLDER PATTERNS: taken from the package names in the
# Raspberry Pi archive's trixie arm64 index on 2026-11-15, not from an image. Confirm them
# against `dpkg -l` on the real image and adjust. Shell-style globs, space separated.
export UPGRADE_HOLD_PACKAGES="linux-image-* linux-headers-* linux-base-* raspi-firmware rpi-eeprom*"

# auto blocks usb-storage on an SD-booted board and leaves it open when / is on USB.
export BLOCK_USB_STORAGE=auto

# The admin's machine, so mistyped passphrases cannot ban the only way in, and the only
# source SSH is allowed from. PLACEHOLDER: 192.0.2.0/24 is a documentation range. A wrong
# SSH_ALLOW_FROM locks you out of SSH once the firewall module runs. Run it from a host
# inside the range.
export FAIL2BAN_IGNOREIP="192.0.2.10"
export SSH_ALLOW_FROM="192.0.2.0/24"
